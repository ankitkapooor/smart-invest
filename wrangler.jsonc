{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valuelens",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-21",
  "routes": [{"pattern": "valuelens.ankitkapoor.me", "custom_domain": true}],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SEC_USER_AGENT": "ValueLens research (https://ankitkapoor.me)",
    "OPENAI_MODEL": "gpt-5.6-terra",
    "RESEARCH_DAILY_LIMIT": "10"
  },
  "durable_objects": {"bindings": [{"name": "RESEARCH", "class_name": "ResearchStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ResearchStore"]}],
  "observability": { "enabled": true }
}
